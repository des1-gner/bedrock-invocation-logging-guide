{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageInvocationLogging",
      "Effect": "Allow",
      "Action": [
        "bedrock:PutModelInvocationLoggingConfiguration",
        "bedrock:GetModelInvocationLoggingConfiguration",
        "bedrock:DeleteModelInvocationLoggingConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassTheLoggingRoleToBedrock",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::<ACCOUNT_ID>:role/<LOGGING_ROLE_NAME>"
    }
  ]
}
